{
  "name": "black-orb",
  "version": "1.5.1",
  "description": "Black Orb is a lightweight and anonymous stock price tracking dashboard",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Marketionist/black-orb"
  },
  "keywords": [
    "black-orb",
    "black orb",
    "black-orb-dashboard",
    "black orb dashboard",
    "stock-price-tracking",
    "stock price tracking",
    "stock-price-tracking-dashboard",
    "stock price tracking dashboard"
  ],
  "author": "Dmytro Shpakovskyi",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:web": "VITE_WEB=true vite",
    "build": "tsc && vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "build:mac": "tsc && vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "build:win": "tsc && vite build && electron-builder --win",
    "build:lin": "tsc && vite build && electron-builder --linux",
    "install:all": "npm install --legacy-peer-deps",
    "lint": "eslint .",
    "prepare": "husky",
    "preview": "vite preview",
    "patch": "npm version patch -m \"Bump up package version to %s\" && git push && git push origin --tags && npm publish",
    "minor": "npm version minor -m \"Bump up package version to %s\" && git push && git push origin --tags && npm publish",
    "major": "npm version major -m \"Bump up package version to %s\" && git push && git push origin --tags && npm publish"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "42.3.3",
    "electron-builder": "^26.15.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^1.0.4",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "main": "dist-electron/main.js"
}
